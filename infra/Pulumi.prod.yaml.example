# Copiez ce fichier vers Pulumi.prod.yaml, puis renseignez les valeurs avec la CLI :
#
#   cd infra
#   pulumi stack init prod
#   pulumi config set scaleway:profile mon-profil
#   pulumi config set clerkPublishableKey pk_live_xxx
#   pulumi config set --secret clerkSecretKey sk_live_xxx
#   pulumi config set adminCidr "$(curl -4 -s https://ifconfig.me)/32"
#   pulumi config set --secret cloudflare:apiToken cf_xxx   # seulement avec un domaine custom
#
# `pulumi config set --secret` chiffre la valeur, mais `Pulumi.prod.yaml` reste hors dépôt :
# il est propre à un projet, quand ce dépôt est un template que l'on clone. Seul ce gabarit
# est versionné ; conservez votre fichier ailleurs et recopiez-le dans chaque clone.
# Ne recopiez jamais un secret en clair ici.
config:
  # Profil de ~/.config/scw/config.yaml. Il porte la clé API, l'organisation et le projet :
  # le stack est ainsi lié à une organisation, quel que soit le profil scw actif.
  scaleway:profile: mon-profil
  acme:region: fr-par
  acme:dbNodeType: DB-DEV-S
  acme:minScale: "1"
  acme:maxScale: "3"
  acme:clerkPublishableKey: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
  # Bloc autorisé sur l'endpoint public de PostgreSQL. Exigé par `pnpm deploy`, qui applique
  # les migrations depuis votre poste.
  # acme:adminCidr: 203.0.113.4/32
  # acme:clerkSecretKey: (chiffré par `pulumi config set --secret`)
  # acme:imageTag: (écrit automatiquement par `pnpm deploy`)

  # --- Nom de domaine (optionnel) — voir docs/DEPLOY.md, section « Nom de domaine » ---------
  # Sans `appHostname` ni `cloudflareZoneId`, aucun enregistrement n'est créé et le provider
  # Cloudflare n'est pas sollicité : son jeton devient inutile.
  # acme:appHostname: app.mondomaine.fr
  # acme:cloudflareZoneId: 0123456789abcdef0123456789abcdef
  # acme:dnsTtl: "300"
  # Proxy Cloudflare : il fait échouer la validation du certificat par Scaleway. Laissez false.
  # acme:cloudflareProxied: "false"
  #
  # Les cinq CNAME du domaine custom Clerk, recopiés depuis le dashboard Clerk → Domains.
  # `key` nomme la ressource Pulumi ; `host` et `target` sont des noms complets ; la partie
  # `xxxxxxxxxxxx` est propre à votre instance Clerk.
  # acme:clerkDnsRecords:
  #   - key: accounts
  #     host: accounts.mondomaine.fr
  #     target: accounts.clerk.services
  #   - key: clerk
  #     host: clerk.mondomaine.fr
  #     target: frontend-api.clerk.services
  #   - key: clk-domainkey
  #     host: clk._domainkey.mondomaine.fr
  #     target: dkim1.xxxxxxxxxxxx.clerk.services
  #   - key: clk2-domainkey
  #     host: clk2._domainkey.mondomaine.fr
  #     target: dkim2.xxxxxxxxxxxx.clerk.services
  #   - key: clkmail
  #     host: clkmail.mondomaine.fr
  #     target: mail.xxxxxxxxxxxx.clerk.services
