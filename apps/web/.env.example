# Source unique de configuration locale.
# Copier ce fichier vers apps/web/.env : il est lu par Next.js, par les scripts db:* et par docker compose.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=acme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://acme:acme@localhost:5432/acme

# --- Clerk ------------------------------------------------------------------
# https://dashboard.clerk.com → API Keys
#
# Attention : les variables NEXT_PUBLIC_* sont inlinées au BUILD de Next, pas à l'exécution.
# En production elles passent en build args Docker (voir docs/DEPLOY.md), jamais en variables
# d'environnement du conteneur — sinon le build est vert et l'application cassée en ligne.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Object storage (MinIO en local, Scaleway Object Storage en production) --
S3_ENDPOINT=http://localhost:9000
# Endpoint atteignable depuis le navigateur pour les URL signées (identique en local).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=acme-attachments
S3_ACCESS_KEY_ID=acme-access-key
S3_SECRET_ACCESS_KEY=acme-secret-key
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
